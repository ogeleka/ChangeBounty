# ChangeBounty production settings. Copy to /opt/changebounty/changebounty.env (root-owned, mode 600).
# This file is read by Docker Compose and is NEVER committed. deploy/scripts/gen-keys.sh fills in the secrets.
# Do not put quotes around values.

# --- Phase 1: bring-up (testnet mode, no contract yet). The site is public, payouts are off. ---
VITE_ARC_NETWORK=testnet
VITE_CHANGEBOUNTY_ADDRESS=
VITE_CHANGEBOUNTY_DEPLOY_TX=
VITE_AGENT_ADDRESS=

# --- Phase 2: after YOU deploy the contract on Arc mainnet, set these and restart (docs/DEPLOYMENT.md step 12) ---
# VITE_ARC_NETWORK=mainnet
# VITE_CHANGEBOUNTY_ADDRESS=0x...your deployed contract...
# VITE_CHANGEBOUNTY_DEPLOY_TX=0x...your deployment transaction hash...
# VITE_AGENT_ADDRESS=0x...wallet that receives rewards (not the verifier)...

# Public origin. The monitoring agent fetches the demo page from here.
PUBLIC_BASE_URL=https://changebounty.ogsnap.online

# Secrets (generated by deploy/scripts/gen-keys.sh; never share, never commit)
VERIFIER_PRIVATE_KEY=
DEMO_ADMIN_TOKEN=

# Tuning (defaults shown)
POLL_INTERVAL_SEC=30
VERIFY_DELAY_SEC=6
MIN_CHANGE_CHARS=24
MIN_REWARD_USDC=0.01
PAYOUT_COOLDOWN_SEC=30
MAX_JOBS_PER_CREATOR=5

# Must stay empty in production (the server refuses to start otherwise).
ALLOW_PRIVATE_FETCH_HOSTS=
