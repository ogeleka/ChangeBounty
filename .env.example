# Network the app runs on: testnet (default) or mainnet
VITE_ARC_NETWORK=testnet
# Deployed ChangeBounty contract and the transaction that deployed it
VITE_CHANGEBOUNTY_ADDRESS=
VITE_CHANGEBOUNTY_DEPLOY_TX=
# Address that receives rewards (the monitoring agent's payee)
VITE_AGENT_ADDRESS=
# Public origin of the deployed app. The agent fetches the demo page from here.
PUBLIC_BASE_URL=
# Where monitoring state is stored (mount a persistent volume here in production)
DATA_DIR=server/data
# Optional tuning
POLL_INTERVAL_SEC=30
VERIFY_DELAY_SEC=6
MIN_CHANGE_CHARS=24
MIN_REWARD_USDC=0.01
PAYOUT_COOLDOWN_SEC=30
MAX_JOBS_PER_CREATOR=5
# Development only. Must be empty in production.
ALLOW_PRIVATE_FETCH_HOSTS=

# SECRETS DO NOT GO IN THIS FILE. Set these as host secrets, or keep them in
# ~/.changebounty/secrets.env (created by `bun run setup:wallets`):
#   VERIFIER_PRIVATE_KEY, DEMO_ADMIN_TOKEN
